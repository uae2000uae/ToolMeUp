# Keep the build context (and image) small and free of local cruft.
# Note: Dualshock-tool/ must stay in the context; the Dockerfile builds it
# in its own stage and only the bundled dist/ is served.
.git
.gitignore
.github
.claude
.idea
*.iml
.venv
**/__pycache__
**/*.pyc
node_modules
**/node_modules
Dualshock-tool/dist

# Build / deploy / docs: never served
Dockerfile
.dockerignore
cloudbuild.yaml
lighthouserc.json
**/*.md
scripts

# Source and reference artwork not used by the site
fitment calculator.xlsx
static/images/temp
static/images/wheels
**/*.ai
**/*.tif
**/*.psd
